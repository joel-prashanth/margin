# Copy to .env and fill in. Never commit .env.

# local | staging | production
ENVIRONMENT=local

# Neon connection string (Dashboard -> Connect), pasted as-is. postgresql:// is fine;
# the app switches it to the psycopg driver.
DATABASE_URL=

# Comma-separated origins allowed to call the API (website, extension).
# The extension's origin is chrome-extension://<extension id>.
CORS_ORIGINS=http://localhost:3000,http://localhost:8766

# AI providers (server-side only)
GEMINI_API_KEY=
